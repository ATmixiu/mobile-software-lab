.index-page {
  min-height: 100vh;
  background-color: #f4f7fb;
}


/* 顶部导航 */
.nav-header {
  position: relative;
  z-index: 30;

  padding: 24rpx 10rpx 28rpx;

  background: linear-gradient(
    180deg,
    #71afe3 0%,
    #9bc9eb 100%
  );
}


.main-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}


.nav-wrapper {
  position: relative;

  flex: 1;

  text-align: center;
}


.nav-item {
  display: inline-block;

  padding: 10rpx 2rpx;

  color: #ffffff;

  font-size: 31rpx;
  font-weight: bold;

  text-shadow: 0 3rpx 7rpx rgba(0, 0, 0, 0.28);
}


.nav-active {
  border-bottom: 5rpx solid #ffffff;
}


/* 下拉菜单 */
.dropdown-panel {
  position: absolute;

  top: 72rpx;
  left: 50%;

  width: 290rpx;

  transform: translateX(-50%);

  overflow: hidden;

  background-color: #ffffff;

  border-radius: 22rpx;

  box-shadow: 0 16rpx 45rpx rgba(0, 54, 113, 0.2);

  z-index: 60;
}


.dropdown-right {
  left: auto;
  right: 0;

  transform: none;
}


.dropdown-item {
  padding: 30rpx 18rpx;

  color: #222222;

  font-size: 28rpx;

  text-align: center;

  border-bottom: 1rpx solid #edf1f5;
}


.dropdown-item:active {
  background-color: #eef6fd;
}


.swipe-tip {
  padding: 15rpx;

  color: #aaaaaa;

  font-size: 20rpx;

  text-align: center;

  background-color: #fafafa;
}


.nav-mask {
  position: fixed;

  left: 0;
  top: 0;
  right: 0;
  bottom: 0;

  z-index: 20;

  background-color: rgba(0, 0, 0, 0.1);
}


/* 内容 */
.page-content {
  position: relative;

  z-index: 10;

  padding-bottom: 40rpx;
}


/* 搜索 */
.search-box {
  height: 76rpx;

  margin: 22rpx 24rpx;

  padding: 0 26rpx;

  display: flex;
  align-items: center;

  background-color: #ffffff;

  border-radius: 38rpx;

  box-shadow: 0 5rpx 20rpx rgba(31, 91, 146, 0.08);
}


.search-symbol {
  margin-right: 15rpx;

  color: #8c99a8;

  font-size: 36rpx;
}


.search-input {
  flex: 1;

  height: 76rpx;

  font-size: 27rpx;
}


.clear-search {
  width: 55rpx;

  color: #999999;

  font-size: 38rpx;

  text-align: center;
}


/* 首页大图 */
.headline-swiper {
  width: calc(100% - 48rpx);
  height: 390rpx;

  margin: 0 24rpx 28rpx;

  border-radius: 24rpx;

  overflow: hidden;

  box-shadow: 0 10rpx 30rpx rgba(0, 44, 94, 0.15);
}


.swiper-card {
  position: relative;

  width: 100%;
  height: 100%;
}


.swiper-image {
  width: 100%;
  height: 100%;
}


.swiper-dark {
  position: absolute;

  left: 0;
  right: 0;
  bottom: 0;

  height: 190rpx;

  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.72) 100%
  );
}


.swiper-info {
  position: absolute;

  left: 30rpx;
  right: 30rpx;
  bottom: 35rpx;

  color: #ffffff;
}


.swiper-date {
  margin-bottom: 10rpx;

  font-size: 22rpx;

  opacity: 0.88;
}


.swiper-title {
  font-size: 33rpx;
  font-weight: bold;

  line-height: 46rpx;
}


/* 首页分类栏目 */
.home-section,
.search-result-area {
  margin: 24rpx;

  padding: 28rpx 26rpx;

  background-color: #ffffff;

  border-radius: 24rpx;

  box-shadow: 0 5rpx 22rpx rgba(19, 73, 122, 0.07);
}


.section-header,
.section-title-row {
  margin-bottom: 12rpx;

  display: flex;
  justify-content: space-between;
  align-items: center;
}


.section-heading {
  display: flex;
  align-items: center;

  color: #164f94;

  font-size: 34rpx;
  font-weight: bold;
}


.section-bar {
  width: 8rpx;
  height: 34rpx;

  margin-right: 14rpx;

  background-color: #328EEB;

  border-radius: 5rpx;
}


.section-title {
  color: #164f94;

  font-size: 34rpx;
  font-weight: bold;
}


.more-button {
  padding: 12rpx;

  color: #6c8fb5;

  font-size: 24rpx;
}


.result-count {
  color: #999999;

  font-size: 24rpx;
}


/* 纯文字新闻卡片 */
.text-news-card {
  position: relative;

  padding: 28rpx 4rpx;

  border-bottom: 1rpx solid #e9edf2;
}


.text-news-card:last-child {
  border-bottom: none;
}


.news-date {
  margin-bottom: 10rpx;

  color: #3276bd;

  font-size: 23rpx;
}


.news-meta {
  margin-bottom: 12rpx;

  display: flex;
  align-items: center;

  color: #999999;

  font-size: 22rpx;
}


.category-tag {
  margin-right: 16rpx;

  padding: 5rpx 13rpx;

  color: #2467ac;

  background-color: #eaf4ff;

  border-radius: 20rpx;
}


.card-title {
  color: #20252b;

  font-size: 30rpx;
  font-weight: 600;

  line-height: 44rpx;
}


.card-summary {
  margin-top: 12rpx;

  color: #777f89;

  font-size: 25rpx;

  line-height: 39rpx;
}


.read-more {
  margin-top: 15rpx;

  color: #4d80b5;

  font-size: 22rpx;

  text-align: right;
}


.empty-search {
  padding: 100rpx 0;

  color: #999999;

  font-size: 27rpx;

  text-align: center;
}