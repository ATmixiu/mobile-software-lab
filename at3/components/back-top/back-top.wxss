.back-top {
  position: fixed;

  right: 28rpx;
  bottom: 155rpx;

  z-index: 888;

  width: 88rpx;
  height: 88rpx;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  box-sizing: border-box;

  color: #ffffff;

  background-color: rgba(50, 142, 235, 0.92);

  border: 2rpx solid rgba(255, 255, 255, 0.85);

  border-radius: 50%;

  box-shadow: 0 8rpx 24rpx rgba(38, 105, 170, 0.28);
}


.back-top-arrow {
  height: 31rpx;

  display: flex;

  align-items: center;

  justify-content: center;

  font-size: 34rpx;

  font-weight: bold;

  line-height: 1;
}


.back-top-text {
  margin-top: 2rpx;

  font-size: 18rpx;

  line-height: 1;
} 