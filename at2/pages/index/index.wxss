.scrollarea{
  height: 100%;
  background-color: #f8f8fa;
  padding:20rpx 30rpx;
  box-sizing: border-box;
}

.id-card-wrap{
  margin-bottom:30rpx;
}
.id-card-wrap image{
  width:100%;
  border-radius:20rpx;
}

.comment{
  text-align:center;
  font: size 14px;
  columns: #999;
}

.text-card{
  background: #ffffff;
  border-radius:24rpx;
  padding:40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  border:2rpx solid #e8e8ee;
}

.title{
  font-size:34rpx;
  font-weight:bold;
  text-align:center;
  margin: 20rpx 0 36rpx 0;
  letter-spacing:2rpx;
}


.item{
  margin-bottom:28rpx;
}
.item:last-child{
  margin-bottom:0;
}

.label{
  font-size:28rpx;
  font-weight:600;
  color:#333;
  margin-bottom:8rpx;
}
.content{
  font-size:26rpx;
  color:#555;
  line-height:1.7;
  text-align:justify;
}
.icon-row{
  display:flex;
  justify-content:center;
  gap:12rpx;
  margin-bottom:20rpx;
}

.icon-item{
  width:52rpx;
  height:52rpx;
  border-radius:50%;
  background:#fff;
  padding:8rpx;
  box-shadow:0 2rpx 6rpx rgba(0,0,0,0.08);
}
