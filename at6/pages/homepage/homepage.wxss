/* pages/homepage/homepage.wxss - 奶油白+珊瑚橙主题 */
.container {
  padding-bottom: 40rpx;
}

/* Profile Card */
.profile-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(47, 43, 42, 0.06);
  position: relative;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: linear-gradient(135deg, #FFF9F5, #FCE8E2);
}

.profile-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  padding: 40rpx 28rpx 24rpx;
}

.avatar-large {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F3EFEC;
  flex-shrink: 0;
  border: 6rpx solid #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(47, 43, 42, 0.1);
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.nickname-large {
  font-size: 38rpx;
  font-weight: 600;
  color: #2F2B2A;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.location-large {
  font-size: 26rpx;
  color: #8A817D;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 28rpx 32rpx;
  position: relative;
  z-index: 1;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-number {
  font-size: 44rpx;
  font-weight: 600;
  color: #2F2B2A;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #8A817D;
}

.stats-divider {
  width: 1rpx;
  height: 64rpx;
  background: #EEEAE6;
}

/* 图片区域 */
.photo-section {
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2F2B2A;
  padding: 0 8rpx 20rpx;
  letter-spacing: 1rpx;
}

/* 图片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.grid-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
  position: relative;
}

.grid-image {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  background: #F3EFEC;
}

.grid-overlay {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  background: linear-gradient(transparent, rgba(47, 43, 42, 0.6));
  padding: 24rpx 12rpx 12rpx;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}

.grid-title {
  font-size: 22rpx;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 编辑资料按钮 */
.edit-profile-btn {
  padding: 12rpx 28rpx;
  background: #FCE8E2;
  color: #F28C74;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* 编辑资料弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(47, 43, 42, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(47, 43, 42, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F2B2A;
  text-align: center;
  margin-bottom: 36rpx;
}

/* 头像选择 */
.edit-avatar-section {
  margin-bottom: 32rpx;
}

.edit-label {
  font-size: 28rpx;
  color: #2F2B2A;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.avatar-choose-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #FAF8F6;
  border-radius: 16rpx;
  line-height: 1.4;
}

.avatar-choose-btn::after {
  border: none;
}

.edit-avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F3EFEC;
  margin-bottom: 16rpx;
}

.avatar-change-text {
  font-size: 24rpx;
  color: #F28C74;
}

/* 昵称输入 */
.edit-nickname-section {
  margin-bottom: 40rpx;
}

.edit-nickname-input {
  width: 100%;
  height: 88rpx;
  background: #FAF8F6;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2F2B2A;
  box-sizing: border-box;
}

/* 弹窗操作按钮 */
.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.cancel-btn {
  background: #F3EFEC;
  color: #756D68;
}

.save-btn {
  background: linear-gradient(135deg, #F28C74, #E87A60);
  color: #fff;
}

.save-btn.disabled {
  opacity: 0.6;
}
