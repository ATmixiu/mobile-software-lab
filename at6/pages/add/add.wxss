/* pages/add/add.wxss - 奶油白+珊瑚橙主题 */
.container {
  padding-bottom: 40rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2F2B2A;
  padding: 28rpx 28rpx 0;
  letter-spacing: 1rpx;
}

/* 上传卡片 */
.upload-card {
  padding-bottom: 28rpx;
}

/* 选择区域 */
.choose-area {
  margin: 24rpx 28rpx;
  height: 380rpx;
  border: 2rpx dashed #E0DAD5;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAF8F6;
}

.choose-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.choose-text {
  font-size: 30rpx;
  color: #756D68;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.choose-sub {
  font-size: 24rpx;
  color: #AAA29E;
}

/* 预览区域 */
.preview-area {
  margin: 24rpx 28rpx;
}

.preview-image {
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: #FAF8F6;
}

/* 进度条 */
.progress-wrap {
  margin-top: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #F3EFEC;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #F28C74, #E87A60);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  text-align: center;
  font-size: 24rpx;
  color: #F28C74;
  margin-top: 12rpx;
}

/* 表单项 */
.form-item {
  margin-top: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2F2B2A;
  margin-bottom: 14rpx;
  font-weight: 600;
}

.required {
  color: #F28C74;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #FAF8F6;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2F2B2A;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #FAF8F6;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #2F2B2A;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 分类选择器 */
.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #FAF8F6;
  border-radius: 16rpx;
  padding: 0 28rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #2F2B2A;
}

.picker-arrow {
  font-size: 36rpx;
  color: #AAA29E;
  font-weight: 300;
}

/* 预览操作按钮 */
.preview-actions {
  display: flex;
  margin-top: 32rpx;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.clear-btn {
  background: #F3EFEC;
  color: #756D68;
}

.upload-btn {
  background: linear-gradient(135deg, #F28C74, #E87A60);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(242, 140, 116, 0.3);
}

.upload-btn.disabled {
  opacity: 0.6;
}

/* 历史卡片 */
.history-card {
  padding-bottom: 28rpx;
}

/* 图片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
}

.grid-item {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
  position: relative;
}

.grid-image {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  background: #F3EFEC;
}

.grid-category {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(47, 43, 42, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}
