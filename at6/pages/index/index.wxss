/* pages/index/index.wxss - 奶油白+珊瑚橙主题 */
.container {
  padding-bottom: 140rpx;
}

/* 欢迎区域 */
.welcome-section {
  padding: 8rpx 8rpx 20rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #2F2B2A;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #8A817D;
}

/* 搜索框 */
.search-bar {
  padding: 0 0 20rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(47, 43, 42, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2F2B2A;
}

.search-clear {
  font-size: 28rpx;
  color: #AAA29E;
  padding: 8rpx;
}

/* 分类栏 */
.category-bar {
  white-space: nowrap;
  padding: 0 0 24rpx;
}

.category-list {
  display: inline-flex;
}

.category-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #756D68;
  background: #F3EFEC;
  border-radius: 32rpx;
  transition: all 0.2s;
  font-weight: 500;
}

.category-item.active {
  background: linear-gradient(135deg, #F28C74, #E87A60);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(242, 140, 116, 0.3);
}

/* 图片卡片 */
.photo-card {
  background: #FFFFFF;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(47, 43, 42, 0.06);
}

/* 用户信息栏 */
.user-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 20rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #F3EFEC;
  margin-right: 18rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #2F2B2A;
  margin-bottom: 4rpx;
}

.location {
  font-size: 22rpx;
  color: #AAA29E;
}

.date {
  font-size: 22rpx;
  color: #C4BCB8;
}

/* 图片 */
.photo-wrap {
  width: 100%;
  background: #FAF8F6;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.photo-image {
  width: 100%;
  display: block;
  border-radius: 16rpx;
}

/* 图片信息 */
.photo-info {
  padding: 20rpx 24rpx 12rpx;
}

.photo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2F2B2A;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.photo-desc {
  font-size: 26rpx;
  color: #756D68;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 底部信息栏 */
.photo-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 24rpx;
}

.footer-left {
  display: flex;
  align-items: center;
}

.category-tag {
  font-size: 22rpx;
  color: #F28C74;
  background: #FCE8E2;
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.footer-right {
  display: flex;
  align-items: center;
}

.footer-item {
  display: flex;
  align-items: center;
  margin-left: 28rpx;
}

.footer-icon {
  font-size: 30rpx;
  margin-right: 8rpx;
  color: #A9A19D;
}

.like-icon.liked {
  color: #F28C74;
}

.footer-count {
  font-size: 24rpx;
  color: #A9A19D;
}

/* 悬浮发布按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #F28C74, #E87A60);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(242, 140, 116, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-more-text {
  font-size: 24rpx;
  color: #AAA29E;
}
