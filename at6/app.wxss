/* app.wxss - 奶油白+珊瑚橙主题 */
page {
  background-color: #F7F5F2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #2F2B2A;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(47, 43, 42, 0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #F28C74, #E87A60);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
  font-weight: 500;
}

.btn-primary::after {
  border: none;
}

.btn-default {
  background: #F3EFEC;
  color: #756D68;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-default::after {
  border: none;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: #8A817D;
  font-size: 26rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FCE8E2;
  border-top-color: #F28C74;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空数据状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #8A817D;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #8A817D;
}

/* 错误提示 */
.error-tip {
  color: #E64340;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.error-text {
  font-size: 28rpx;
  color: #8A817D;
  margin-bottom: 24rpx;
}

.retry-btn {
  padding: 16rpx 40rpx;
  background: #F28C74;
  color: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F3EFEC;
}

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #EEEAE6;
  margin: 20rpx 0;
}

/* 主题色文字 */
.text-primary {
  color: #F28C74;
}

.text-secondary {
  color: #8A817D;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-primary {
  background: #FCE8E2;
  color: #F28C74;
}

.tag-secondary {
  background: #E7E0F5;
  color: #7B6FB0;
}
